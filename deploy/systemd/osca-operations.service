[Unit]
Description=OSCA Personal Server Operations
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=osca
Group=osca
WorkingDirectory=/opt/osca
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/osca/.venv/bin/python -m osca.personal_server security-check --host 127.0.0.1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/osca /var/backups/osca
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
