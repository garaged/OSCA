{
  "productName": "OSCA Desktop",
  "version": "0.2.0-alpha.1",
  "identifier": "io.github.garaged.osca",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "OSCA Desktop",
      "width": 1180,
      "height": 760,
      "minWidth": 320,
      "minHeight": 480
    }],
    "security": {
      "capabilities": ["desktop"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "font-src": "'self' http://localhost:1420",
        "img-src": "'self' data: http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/osca-sidecar"]
  }
}
