{
  "productName": "OSCA Desktop",
  "version": "0.2.0-alpha.1",
  "identifier": "io.github.garaged.osca",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "OSCA Desktop",
      "width": 1180,
      "height": 760,
      "minWidth": 320,
      "minHeight": 480
    }],
    "security": {
      "capabilities": ["desktop"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
